+def _seconds_since(offered_at: Any) -> float | None:
+    """Seconds since an offer's UTC timestamp, or None when it cannot be read.
+
+    Two faults lived here. ``time.mktime`` read the UTC string as LOCAL time,
+    so on a machine west of Greenwich the offer landed in the future and every
+    real close logged a duration of 0.0. And an unreadable timestamp became
+    "now", logging 0.0 again -- a default the sender never sent, the thing
+    ``inspect_handshake`` refuses. Unknown is None, not zero.
+    """
+    try:
+        offered = calendar.timegm(time.strptime(str(offered_at), "%Y-%m-%dT%H:%M:%SZ"))
+    except (ValueError, TypeError):
+        return None
+    return max(0.0, time.time() - offered)
+
+
 def _append_audit_log(pending: dict[str, Any], outcome: CloseOutcome) -> None:
     """Append one closed-cycle record. A write failure RAISES."""
     path = _audit_log_path()
diff --git a/tests/test_auto_cycle_phase2.py b/tests/test_auto_cycle_phase2.py
index 14d481845..34f3d6af5 100644
--- a/tests/test_auto_cycle_phase2.py
+++ b/tests/test_auto_cycle_phase2.py
@@ -354,6 +354,55 @@ class TestCloseCycle:
         assert _pending().read_text(encoding="utf-8") == "{half a rec"
         assert not ac._audit_log_path().exists()
 
+    def test_duration_is_measured_in_utc_not_local_time(self, home: Path):
+        """The offer time is written in UTC. Read back as local time, it landed
+        hours in the future west of Greenwich and every close logged 0.0."""
+        import time as _time
+
+        _write_handshake()
+        offer_cycle()
+        pending = json.loads(_pending().read_text(encoding="utf-8"))
+        pending["offered_at"] = _time.strftime(
+            "%Y-%m-%dT%H:%M:%SZ", _time.gmtime(_time.time() - 90)
+        )
+        _pending().write_text(json.dumps(pending), encoding="utf-8")
+        result = close_cycle("timeout")
+        assert result is not None and result.duration_sec is not None
+        assert 85 <= result.duration_sec <= 150
+
+    def test_an_unreadable_offer_time_is_unknown_not_zero(self, home: Path):
+        _write_handshake()
+        offer_cycle()
+        pending = json.loads(_pending().read_text(encoding="utf-8"))
+        pending["offered_at"] = "sometime"
+        _pending().write_text(json.dumps(pending), encoding="utf-8")
+        result = close_cycle("timeout")
+        assert result is not None and result.duration_sec is None
+        entry = json.loads(ac._audit_log_path().read_text(encoding="utf-8").splitlines()[0])
+        assert entry["duration_sec"] is None
+
+    def test_a_close_repeated_after_a_crash_logs_the_cycle_once(
+        self, home: Path, monkeypatch: pytest.MonkeyPatch
+    ):
+        """If clearing the markers fails after the audit line is written, the
+        pending record survives; closing again must not log the cycle twice."""
+        _write_handshake()
+        offer_cycle()
+
+        def _boom() -> None:
+            raise OSError("disk went away mid-close")
+
+        monkeypatch.setattr(ac, "clear_handshake_marker", _boom)
+        with pytest.raises(OSError):
+            close_cycle("timeout")
+        assert _pending().exists()
+        monkeypatch.undo()
+        monkeypatch.setenv("DIVINEOS_HOME", str(home))
+        close_cycle("timeout")
+        lines = ac._audit_log_path().read_text(encoding="utf-8").splitlines()
+        assert len(lines) == 1
+        assert not _pending().exists()
+
     def test_close_appends_to_audit_log(self, home: Path):
         _write_handshake()
         offer_cycle()
